TARGET_URL=https://your-checkin-domain.example.com
CHECKIN_USERNAME=your_username
CHECKIN_PASSWORD=your_password
TIMEZONE=Asia/Shanghai

SITE_CONFIG_PATH=./config/site-config.json
# 普通用户建议：CHECKIN_STEPS=personal 且 SITE_CONFIG_PATH=./config/site-config.student.json
CHECKIN_STEPS=personal,leader
CHECKIN_PRECHECK=true
SCREENSHOT_DIR=./runtime/screenshots
LOG_PATH=./runtime/app.log
MAX_ATTEMPTS=3
BACKOFF_MIN_MS=30000
BACKOFF_MAX_MS=90000
HEADLESS=true
BROWSER_CHANNEL=msedge
BROWSER_TIMEOUT_MS=20000
BROWSER_SLOW_MO_MS=0
CHECKIN_ACTION_BUFFER_MS=1500
LOGIN_TYPE_DELAY_MS=180
LOGIN_FIELD_SETTLE_MS=2000
LOGIN_NAME_READY_SETTLE_MS=1500
LOGIN_PASTE_SETTLE_MS=1200
LOGIN_INPUT_MODE=ime
LOGIN_IME_TEXT=
LOGIN_IME_COMMIT_KEY=SPACE
LOGIN_WINDOW_TITLE=学生日常打卡系统
